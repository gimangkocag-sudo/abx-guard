# Tambahkan ke .env project Laravel kamu (bukan pengganti .env.example bawaan Laravel).
# Pilih SATU database. Contoh MySQL:
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=abx_guard
DB_USERNAME=
DB_PASSWORD=
# Contoh PostgreSQL: DB_CONNECTION=pgsql, DB_PORT=5432

# Akun admin untuk seeder. ADMIN_EMAIL dan ADMIN_PASSWORD WAJIB diisi di environment selain local/testing (seeder menolak berjalan tanpa itu). Di local, boleh dikosongkan (memakai default development).
ADMIN_EMAIL=
ADMIN_PASSWORD=
